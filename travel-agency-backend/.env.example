# --- Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173        # comma-separate to allow several origins

# --- Auth (REQUIRED) ---
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Database: a URL OR the individual settings ---
# DATABASE_URL=postgresql://user:pass@host:5432/voyage_travel
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voyage_travel
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false                              # true for managed Postgres (Render, RDS, Neon)

# --- Optional: Redis cache (leave unset to run without caching) ---
# REDIS_URL=redis://localhost:6379

# --- Optional: transactional email (leave unset to disable) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- Optional: AI concierge (endpoint returns 503 when unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
