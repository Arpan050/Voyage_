# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.

# Required
POSTGRES_PASSWORD=
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
FRONTEND_URL=http://localhost:8080
EMAIL_USER=
EMAIL_PASS=
ANTHROPIC_API_KEY=          # enables the AI concierge; it returns a friendly "not configured" message when empty
